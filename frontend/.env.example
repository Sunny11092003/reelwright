# Public Firebase web config (safe to expose; security comes from Firebase Auth + Firestore rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Leave empty in dev to use the Vite proxy (/api -> http://localhost:4000). Set to the backend URL in production.
VITE_API_BASE_URL=
VITE_MAX_UPLOAD_MB=100
