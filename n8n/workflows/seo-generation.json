{
  "name": "ACA - SEO generation",
  "nodes": [
    {
      "id": "cf194baa-328f-43d0-a64e-89aa8210c19f",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "webhookId": "448dbf39-dc55-4396-83c3-ee68186b1fba",
      "parameters": {
        "httpMethod": "POST",
        "path": "aca/seo-generation",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "2e5da3e7-fc7c-475c-9931-671f1b05919b",
      "name": "Valid secret?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        240,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "24c3f5e4-6c3f-4f60-9da6-205a93b2f4c6",
              "leftValue": "={{ $json.headers['x-aca-secret'] }}",
              "rightValue": "={{ $env.ACA_WEBHOOK_SECRET }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "9fc3e696-bdb2-479d-a35c-236b98ca8b31",
      "name": "Reject",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        480,
        360
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\"error\":\"invalid secret\"} }}",
        "options": {
          "responseCode": 401
        }
      }
    },
    {
      "id": "e810e7bc-7259-4887-8f09-0c62cb33c185",
      "name": "Accept",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        480,
        120
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\"accepted\":true} }}",
        "options": {
          "responseCode": 202
        }
      }
    },
    {
      "id": "5fe93d2c-9bd1-405f-a140-1509a68eddd3",
      "name": "Run stage on backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        120
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ACA_BACKEND_URL }}/api/internal/stages/seo-analysis/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-secret",
              "value": "={{ $env.ACA_INTERNAL_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ userId: $('Webhook').item.json.body.userId, resourceId: $('Webhook').item.json.body.resourceId, requestId: $('Webhook').item.json.body.requestId }) }}",
        "options": {
          "timeout": 900000
        }
      }
    },
    {
      "id": "9670c985-6c2c-41b0-9b22-4dcf79541a61",
      "name": "Report completed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        40
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ACA_BACKEND_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-aca-secret",
              "value": "={{ $env.ACA_WEBHOOK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event: 'stage.completed', stage: 'seo-analysis', userId: $('Webhook').item.json.body.userId, resourceId: $('Webhook').item.json.body.resourceId, requestId: $('Webhook').item.json.body.requestId || 'n8n' }) }}",
        "options": {
          "timeout": 20000
        }
      }
    },
    {
      "id": "1563058f-185a-4024-aa52-4356176da45c",
      "name": "Report failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        220
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ACA_BACKEND_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-aca-secret",
              "value": "={{ $env.ACA_WEBHOOK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event: 'stage.failed', stage: 'seo-analysis', userId: $('Webhook').item.json.body.userId, resourceId: $('Webhook').item.json.body.resourceId, requestId: $('Webhook').item.json.body.requestId || 'n8n', error: { code: 'N8N_STEP_FAILED', message: String($json.error && $json.error.message || $json.message || 'Workflow step failed').slice(0, 900) } }) }}",
        "options": {
          "timeout": 20000
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Valid secret?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Valid secret?": {
      "main": [
        [
          {
