            "index": 0
          }
        ]
      ]
    },
    "Run stage on backend": {
      "main": [
        [
          {
            "node": "Report completed",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Report failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
