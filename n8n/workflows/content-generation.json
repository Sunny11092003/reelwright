{
  "name": "ACA - Content generation",
  "nodes": [
    {
      "id": "fce3ccc2-d98d-451f-8e8c-4f8de8756752",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
