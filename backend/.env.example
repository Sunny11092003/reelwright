# ======================================================================
# AI Content & Social Publishing Agent: backend environment
# Copy to .env (repo root, used by docker compose) and to backend/.env (local dev).
# Never commit real values.
# ======================================================================
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Where the React app is served from (used for CORS and OAuth redirects back to the app)
FRONTEND_URL=http://localhost:5173
# Public URL of THIS backend (Meta redirects the browser here after login). Must be https in production.
BACKEND_PUBLIC_URL=http://localhost:4000
# Extra allowed browser origins, comma separated (optional)
CORS_ALLOWED_ORIGINS=

# ---- Firebase Admin (Project settings > Service accounts > Generate new private key) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the \n escapes exactly as in the JSON key file
FIREBASE_PRIVATE_KEY=""

# ---- Cloudinary (Dashboard > API keys) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=ai-content-agent
# Cloudinary free plans limit video uploads to 100 MB. Raise only if your plan allows it.
MAX_UPLOAD_MB=100

# ---- AI providers ----
AI_DEFAULT_PROVIDER=gemini
# Google AI Studio key: https://aistudio.google.com/apikey (required: video analysis uses Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional text provider (SEO / content generation). Anthropic cannot analyze video.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Meta (Instagram + Facebook) ----
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# ---- n8n ----
# Reachable from the backend. With docker compose use http://n8n:5678
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_PATH_PREFIX=/webhook/aca
# Shared secrets. Generate each with: openssl rand -hex 32
# Backend -> n8n and n8n -> backend callbacks (header x-aca-secret)
N8N_WEBHOOK_SECRET=
# n8n -> backend internal API (header x-internal-secret)
INTERNAL_API_SECRET=
# Default execution mode for new users: "direct" (no n8n needed) or "n8n"
DEFAULT_EXECUTION_MODE=direct
# true = backend polls for due scheduled posts itself (use when n8n scheduling workflow is not active)
RUN_INTERNAL_SCHEDULER=true

# ---- Security ----
# Signs the OAuth state parameter. openssl rand -hex 32
SESSION_SECRET=
# Encrypts OAuth tokens and WordPress credentials at rest (AES-256-GCM). openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
AI_RATE_LIMIT_MAX=30
# Local development only: allow WordPress sites on localhost / private IPs
ALLOW_PRIVATE_WORDPRESS_HOSTS=false

# ---- Optional: Google Analytics 4 for website traffic (service account with Viewer access to the property) ----
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=""

# ---- n8n container settings (docker compose only) ----
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=Asia/Kolkata

# ---- Frontend build values (public; used by docker compose frontend build) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=http://localhost:4000
