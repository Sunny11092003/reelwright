rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() { return signedIn() && resource.data.userId == request.auth.uid; }

    // All writes go through the backend (Admin SDK bypasses these rules). Clients can only read their own documents.
    match /users/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /brands/{id}            { allow read: if owner(); allow write: if false; }
    match /videos/{id}            { allow read: if owner(); allow write: if false; }
    match /videoAnalysis/{id}     { allow read: if owner(); allow write: if false; }
    match /seoAnalyses/{id}       { allow read: if owner(); allow write: if false; }
    match /content/{id}           { allow read: if owner(); allow write: if false; }
    match /contentVersions/{id}   { allow read: if owner(); allow write: if false; }
    match /connectedAccounts/{id} { allow read: if owner(); allow write: if false; }
    match /scheduledPosts/{id}    { allow read: if owner(); allow write: if false; }
    match /publishedPosts/{id}    { allow read: if owner(); allow write: if false; }
    match /publishingJobs/{id}    { allow read: if owner(); allow write: if false; }
    match /analytics/{id}         { allow read: if owner(); allow write: if false; }
    match /settings/{id}          { allow read: if owner(); allow write: if false; }
    match /activityLogs/{id}      { allow read: if owner(); allow write: if false; }

    // Encrypted OAuth tokens and WordPress credentials: never readable from clients.
    match /accountSecrets/{id} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
